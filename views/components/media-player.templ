package components

// MediaPlayer lives outside the refreshed library so playback survives list updates.
templ MediaPlayer() {
	<style>#media-player [hidden]{display:none!important}</style>
	<dialog id="media-player" class="modal" aria-labelledby="media-player-title" aria-describedby="media-player-help">
		<div class="modal-box w-full max-w-5xl">
			<div class="flex items-center justify-between gap-3 mb-4">
				<h2 id="media-player-title" class="text-lg font-semibold break-words">Media player</h2>
				<button type="button" data-media-close class="btn btn-ghost btn-sm" autofocus>Close</button>
			</div>
			<p id="media-player-status" role="status" aria-live="polite" class="text-sm mb-3">Loading media…</p>
			<div id="media-player-content"></div>
			<p id="media-player-error" role="alert" class="text-error text-sm mt-3" hidden></p>
			<div class="flex flex-wrap items-center justify-between gap-3 mt-4">
				<p id="media-player-help" class="text-sm">Playback depends on your browser's codec support. If it cannot play, download the file instead.</p>
				<a id="media-player-download" class="btn btn-outline btn-sm" target="_blank" rel="noopener noreferrer" hx-boost="false" hidden>Download file</a>
			</div>
		</div>
	</dialog>
}
