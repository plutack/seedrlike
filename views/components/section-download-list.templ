package components

import "fmt"
import database "github.com/plutack/seedrlike/internal/database/sqlc"

func formatSize(size int64) string {
	sizeInMB := float64(size) / 1000000
	return fmt.Sprintf("%.2f", sizeInMB)
}

func returnFileDownloadUrl(server string, contentID string, name string) string {
	return fmt.Sprintf("https://%s.gofile.io/download/web/%s/%s", server, contentID, name)
}

func returnFolderDownloadUrl(contentID string) string {
	return fmt.Sprintf("https://gofile.io/d/%s", contentID)
}

func returnContentDeleteUrl(contentID, contentType string) string {
	return fmt.Sprintf("/contents/%s?type=%s", contentID, contentType)
}

templ DownloadList(returnErr bool, torrents []database.GetFolderContentsRow, folderID string, isLoggedIn bool) {
	@DownloadListWithOptions(returnErr, torrents, folderID, isLoggedIn, LibraryOptionsFromContext(ctx))
}

templ DownloadListWithOptions(returnErr bool, torrents []database.GetFolderContentsRow, folderID string, isLoggedIn bool, options LibraryOptions) {
	<div
		id="content-list"
		x-data="{ mutationError: '' }"
		x-on:htmx:after-request.camel="if ($event.detail.requestConfig.verb.toLowerCase() === 'delete' && !$event.detail.successful) mutationError = 'Deletion could not be completed. Library records were preserved for unconfirmed deletions; some remote items may already have been removed. Please refresh and check before retrying.'"
		hx-get={ options.FolderURL(folderID) }
		hx-trigger="refresh from:body"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
			<div role="alert" class="alert alert-error mb-3" x-show="mutationError" x-cloak><span x-text="mutationError"></span></div>
			<!-- Toolbar: breadcrumb + actions -->
			<div class="flex flex-wrap items-center justify-between gap-3 mb-3">
				<nav class="flex items-center gap-1.5 text-sm font-medium" aria-label="Breadcrumb">
					<a href="/" class="inline-flex items-center gap-1.5 hover:text-primary transition-colors">
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h4v6h3a1 1 0 001-1V10"></path>
						</svg>
						Home
					</a>
				</nav>
				<div class="flex items-center gap-2">
					<button
						class="btn btn-ghost btn-sm btn-square"
						title="Refresh"
						aria-label="Refresh"
						hx-get={ options.FolderURL(folderID) }
						hx-target="#content-list"
						hx-swap="outerHTML"
					>
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M5 9a7 7 0 0112-3l3 3M19 15a7 7 0 01-12 3l-3-3"></path>
						</svg>
					</button>
					if isLoggedIn {
						<button
							class="btn btn-outline btn-error btn-sm"
							hx-delete={ options.StaleDeleteURL(folderID) }
							hx-target="#content-list"
							hx-swap="outerHTML"
						>
							Delete stale
						</button>
					}
				</div>
			</div>
			<form action={ templ.SafeURL("/contents/" + folderID) } method="get" hx-get={ "/contents/" + folderID } hx-target="#content-list" hx-swap="outerHTML" hx-push-url="true" class="flex flex-wrap items-end gap-3 mb-4" role="search" aria-label="Search your library">
				<div class="flex-1 min-w-48">
					<label for="library-query" class="block text-sm font-medium mb-1">Search library</label>
					<input id="library-query" type="search" name="q" value={ options.Query } maxlength="200" placeholder="Find files and folders in your library" class="input input-bordered input-sm w-full"/>
				</div>
				<div>
					<label for="library-sort" class="block text-sm font-medium mb-1">Sort by</label>
					<select id="library-sort" name="sort" class="select select-bordered select-sm">
						<option value="name" selected={ options.Sort == "name" }>Name</option>
						<option value="size" selected={ options.Sort == "size" }>Size</option>
						<option value="date" selected={ options.Sort == "date" }>Date added</option>
					</select>
				</div>
				<div>
					<label for="library-order" class="block text-sm font-medium mb-1">Order</label>
					<select id="library-order" name="order" class="select select-bordered select-sm">
						<option value="asc" selected={ options.Order == "asc" }>Ascending</option>
						<option value="desc" selected={ options.Order == "desc" }>Descending</option>
					</select>
				</div>
				<button type="submit" class="btn btn-primary btn-sm">Apply</button>
			</form>
			if options.Query != "" {
				<div class="flex items-center justify-between gap-3 mb-3 text-sm" role="status">
					<p>Library results for <strong>{ options.Query }</strong> · { fmt.Sprint(len(torrents)) } items. This searches your accessible files, not external torrents.</p>
					<a href={ templ.SafeURL(options.ClearURL(folderID)) } hx-get={ options.ClearURL(folderID) } hx-target="#content-list" hx-swap="outerHTML" hx-push-url="true" class="link whitespace-nowrap">Clear search</a>
				</div>
			}
			if returnErr {
				<div role="alert" class="alert alert-error">
					<span>We couldn’t load your library. Try refreshing the list.</span>
				</div>
			} else if len(torrents) == 0 {
				<div class="rounded-box border border-dashed border-base-300 bg-base-200/30 py-16 text-center text-base-content/60">
					<svg class="w-10 h-10 mx-auto mb-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"></path>
					</svg>
					if options.Query != "" {
						<p>No library items match your search.</p>
						<p class="text-sm mt-1">Try another name or clear the search to browse this folder.</p>
					} else {
						<p>This folder is empty</p>
					}
				</div>
			} else {
				<div
					x-data="{
						count: 0,
						deleting: false,
						deleteError: '',
						sync() { this.count = this.$root.querySelectorAll('.row-check:checked').length; },
						toggleAll(e) {
							this.$root.querySelectorAll('.row-check').forEach(c => c.checked = e.target.checked);
							this.sync();
						},
						async deleteSelected() {
							if (this.deleting) return;
							const checked = [...this.$root.querySelectorAll('.row-check:checked')];
							if (!checked.length) { this.$refs.deleteDialog.close(); return; }
							this.deleting = true;
							this.deleteError = '';
							let failed = 0;
							for (const c of checked) {
								try {
									const response = await fetch('/contents/' + encodeURIComponent(c.dataset.id) + '?type=' + encodeURIComponent(c.dataset.type), { method: 'DELETE' });
									if (response.ok) { c.checked = false; c.disabled = true; } else { failed++; }
								} catch (_) { failed++; }
							}
							this.deleting = false;
							this.sync();
							if (failed) {
								this.deleteError = failed + ' item(s) could not be deleted. They may no longer be available, or you may not have permission. Please try again.';
							} else {
								this.$refs.deleteDialog.close();
								htmx.trigger('#content-list', 'refresh');
							}
						}
					}"
					class="rounded-box border border-base-300 bg-base-100 overflow-hidden shadow-sm"
				>
					<!-- Selection action bar -->
					<div
						x-show="count > 0"
						x-cloak
						class="flex items-center justify-between gap-3 px-4 py-2 bg-primary/10 border-b border-base-300 text-sm"
					>
						<span x-text="count + ' selected'" class="font-medium"></span>
						<button type="button" class="btn btn-error btn-xs" x-on:click="deleteError = ''; $refs.deleteDialog.showModal()">Delete selected</button>
					</div>
					<dialog x-ref="deleteDialog" class="modal modal-bottom sm:modal-middle" aria-labelledby="delete-selected-title" x-on:cancel="if (deleting) $event.preventDefault()">
						<div class="modal-box">
							<h3 id="delete-selected-title" class="font-semibold text-lg">Delete selected items?</h3>
							<p class="py-3 text-sm text-base-content/80">This permanently removes <span class="font-medium" x-text="count"></span> selected item(s) and their contents. This cannot be undone.</p>
							<p role="alert" class="text-error text-sm" x-show="deleteError" x-text="deleteError" x-cloak></p>
							<div class="modal-action">
								<button type="button" class="btn btn-ghost btn-sm" x-bind:disabled="deleting" x-on:click="$refs.deleteDialog.close(); htmx.trigger('#content-list', 'refresh')" autofocus>Cancel</button>
								<button type="button" class="btn btn-error btn-sm" x-bind:disabled="deleting || count === 0" x-on:click="deleteSelected()" x-text="deleting ? 'Deleting...' : 'Delete items'">Delete items</button>
							</div>
						</div>
					</dialog>
					<!-- Column header -->
					<div class="hidden sm:grid sm:grid-cols-[auto_auto_1fr_auto_auto] items-center gap-3 px-4 py-2.5 border-b border-base-300 bg-base-200/50 text-xs font-semibold uppercase tracking-wide text-base-content/60">
						<input type="checkbox" class="checkbox checkbox-sm" aria-label="Select all" x-on:change="toggleAll($event)"/>
						<span class="w-5"></span>
						<span>Name</span>
						<span class="text-right pr-2">Size (MB)</span>
						<span class="text-center w-20">Actions</span>
					</div>
					<!-- Rows -->
					<div class="divide-y divide-base-200">
						for _, torrent := range torrents {
							<div class="grid grid-cols-[auto_1fr_auto] grid-rows-[auto_auto] sm:grid-cols-[auto_auto_1fr_auto_auto] sm:grid-rows-1 items-center gap-x-3 gap-y-0.5 px-3 sm:px-4 py-2.5 hover:bg-base-200/40 transition-colors">
								<input
									type="checkbox"
									class="row-check checkbox checkbox-sm hidden sm:block sm:col-start-1"
									data-id={ torrent.ID }
									data-type={ torrent.Type }
									aria-label="Select item"
									x-on:change="sync()"
								/>
								if torrent.Type == "folder" {
									<img src="/assets/images/folder-close.svg" alt="folder" class="w-5 h-5 opacity-80 col-start-1 row-start-1 row-span-2 sm:col-start-2 sm:row-span-1"/>
								} else {
									<img src="/assets/images/file.svg" alt="file" class="w-5 h-5 opacity-80 col-start-1 row-start-1 row-span-2 sm:col-start-2 sm:row-span-1"/>
								}
								if torrent.Type == "folder" {
									<a
										href={ templ.SafeURL(options.ClearURL(torrent.ID)) }
										hx-get={ options.ClearURL(torrent.ID) }
										hx-target="#content-list"
										hx-swap="outerHTML"
										hx-push-url="true"
										class="col-start-2 row-start-1 sm:col-start-3 truncate hover:text-primary transition-colors"
										title={ torrent.Name }
									>
										{ torrent.Name }
									</a>
								} else {
									<!-- Files are not navigable; the name opens the file download instead. -->
									<a
										href={ templ.SafeURL(returnFileDownloadUrl(torrent.Server, torrent.ID, torrent.Name)) }
										target="_blank"
										class="col-start-2 row-start-1 sm:col-start-3 truncate hover:text-primary transition-colors"
										title={ torrent.Name }
									>
										{ torrent.Name }
									</a>
								}
								<span class="col-start-2 row-start-2 sm:col-start-4 sm:row-start-1 text-xs text-base-content/60 sm:text-sm sm:text-base-content/70 sm:text-right tabular-nums sm:pr-2 whitespace-nowrap">{ formatSize(torrent.Size) }<span class="sm:hidden"> MB</span></span>
								<div class="col-start-3 row-start-1 row-span-2 sm:col-start-5 sm:row-span-1 flex items-center justify-end gap-2 sm:gap-1">
									<a
										if torrent.Type == "folder" {
											href={ templ.SafeURL(returnFolderDownloadUrl(torrent.ID)) }
										} else {
											href={ templ.SafeURL(returnFileDownloadUrl(torrent.Server, torrent.ID, torrent.Name)) }
										}
										target="_blank"
										class="btn btn-ghost btn-sm sm:btn-xs btn-square"
										title="Download"
										aria-label="Download"
									>
										<svg class="w-5 h-5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16"></path>
										</svg>
									</a>
									<button
										disabled={ !isLoggedIn }
										hx-delete={ options.DeleteURL(torrent.ID, torrent.Type, folderID) }
										hx-target="#content-list"
										hx-swap="outerHTML"
										hx-on::htmx:afterRequest="htmx.trigger('#content-list', 'refresh')"
										class="btn btn-ghost btn-sm sm:btn-xs btn-square text-error hover:bg-error/10"
										title="Delete"
										aria-label="Delete"
									>
										<svg class="w-5 h-5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M6 7h12M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2m-7 0v12a1 1 0 001 1h6a1 1 0 001-1V7"></path>
										</svg>
									</button>
								</div>
							</div>
						}
					</div>
				</div>
			}
		</div>
	</div>
}
