package components

import "github.com/plutack/seedrlike/internal/notifications"
import "fmt"

templ NotificationSettings(s notifications.Settings, csrf string, message string, isError bool) {
 <section class="mx-auto max-w-2xl px-4 py-8 sm:py-12" aria-labelledby="settings-title">
  <a href="/" class="link text-sm text-base-content/70">← Back to your files</a>
  <h1 id="settings-title" class="text-3xl font-bold mt-6 mb-8">Email notifications</h1>
  if message != "" {
   if isError {
    <div role="alert" class="alert alert-error mb-6">{ message }</div>
   } else {
    <div role="status" class="alert alert-success mb-6">{ message }</div>
   }
  }
  <div class="card bg-base-100 border border-base-300 shadow-sm">
   <div class="card-body">
    <form method="post" action="/settings" class="space-y-6"
     data-email={ s.Email } data-verified={ fmt.Sprint(s.Verified) }
     x-data="{ email: $el.dataset.email, originalEmail: $el.dataset.email, originallyVerified: $el.dataset.verified === 'true', get verified() { return this.originallyVerified && this.email.trim() === this.originalEmail; } }">
     <input type="hidden" name="csrf" value={ csrf }/>
     <div>
      <label for="notification-email" class="label font-medium">Notification email</label>
      <input id="notification-email" type="email" name="email" value={ s.Email } x-model="email" maxlength="254" autocomplete="email" class="input input-bordered w-full" aria-describedby="email-status"/>
      <p id="email-status" class="text-sm font-medium mt-3" aria-live="polite">
       <span class="badge badge-success" x-show="verified" x-cloak>Verified</span>
       <span class="badge badge-warning" x-show="email.trim() && !verified" x-cloak>Not verified</span>
       <span class="badge badge-ghost" x-show="!email.trim()" x-cloak>Not set</span>
      </p>
     </div>
     <fieldset class="border-t border-base-300 pt-4">
      <legend class="font-semibold px-1">Notify me when</legend>
      <label class="flex items-center gap-3 py-3 cursor-pointer" for="notify-completed">
       <input id="notify-completed" type="checkbox" name="completed" class="toggle toggle-primary" checked?={ s.Completed }/>
       <span class="font-medium">Download completed</span>
      </label>
      <label class="flex items-center gap-3 py-3 cursor-pointer" for="notify-failed">
       <input id="notify-failed" type="checkbox" name="failed" class="toggle toggle-primary" checked?={ s.Failed }/>
       <span class="font-medium">Download failed</span>
      </label>
     </fieldset>
     <div class="flex flex-wrap gap-3">
      if s.Verified || s.Email == "" {
       <button type="submit" name="action" value="save" x-bind:value="email.trim() && !verified ? 'verify' : 'save'" x-text="email.trim() && !verified ? 'Save & verify' : 'Save'" class="btn btn-primary">Save</button>
      } else {
       <button type="submit" name="action" value="verify" x-bind:value="email.trim() && !verified ? 'verify' : 'save'" x-text="email.trim() && !verified ? 'Save & verify' : 'Save'" class="btn btn-primary">Save &amp; verify</button>
      }
      <button type="submit" name="action" value="unset" class="btn btn-outline" formnovalidate>Unset</button>
     </div>
    </form>
   </div>
  </div>
 </section>
}

templ ConfirmNotificationEmail(token string, csrf string) {
 <section class="mx-auto max-w-2xl px-4 py-12">
  <div class="card bg-base-100 border border-base-300 shadow-sm"><div class="card-body">
   <h1 class="text-3xl font-bold">Confirm your email</h1>
   <p class="text-base-content/70 py-4">Verify this address for your notification settings.</p>
   <form method="post" action="/settings/verify">
    <input type="hidden" name="token" value={ token }/>
    <input type="hidden" name="csrf" value={ csrf }/>
    <button type="submit" class="btn btn-primary">Verify my email</button>
    <a href="/settings" class="btn btn-ghost">Not now</a>
   </form>
  </div></div>
 </section>
}
