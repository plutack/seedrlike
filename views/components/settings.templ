package components

import "github.com/plutack/seedrlike/internal/notifications"
import "encoding/json"

func notificationEditor(s notifications.Settings) string {
 raw, _ := json.Marshal(struct { Email string `json:"email"`; SavedEmail string `json:"savedEmail"`; Verified bool `json:"verified"` }{s.Email,s.Email,s.Verified})
 return string(raw)
}

templ NotificationSettings(s notifications.Settings, csrf string, message string, isError bool) {
 <section class="mx-auto max-w-2xl px-4 py-8 sm:py-12" aria-labelledby="settings-title">
  <a href="/" class="link text-sm text-base-content/80">← Back to your files</a>
  <div class="mt-6 mb-6">
   <h1 id="settings-title" class="text-2xl font-semibold">Email notifications</h1>
   <p class="text-sm text-base-content/80 mt-2">Choose which download updates you receive.</p>
  </div>
  if message != "" {
   if isError {
    <div role="alert" class="alert alert-error mb-6">{ message }</div>
   } else {
    <div role="status" class="alert alert-success mb-6">{ message }</div>
   }
  }
  <div x-data={ notificationEditor(s) } class="rounded-box bg-base-100 border border-base-300 p-5 sm:p-6">
   <form method="post" action="/settings" class="space-y-5">
    <input type="hidden" name="csrf" value={ csrf }/>
    <div>
     <div class="flex items-center justify-between gap-3 mb-2">
      <label for="notification-email" class="text-sm font-medium">Email address</label>
      <span id="email-status" role="status" class="text-xs text-base-content/80" x-text="email.trim() === '' ? 'Off' : (email.trim() !== savedEmail ? 'Unsaved' : (verified ? 'Verified' : 'Unverified'))">
       if s.Email == "" {
        Off
       } else if s.Verified {
        Verified
       } else {
        Unverified
       }
      </span>
     </div>
     <input id="notification-email" type="email" name="email" value={ s.Email } x-model="email" maxlength="254" autocomplete="email" class="input input-bordered w-full" aria-describedby="email-help email-status"/>
     <p id="email-help" class="text-xs text-base-content/80 mt-2">Verify a new address before receiving updates. Clear and save to stop emails.</p>
    </div>
    <fieldset class="border-t border-base-300 pt-4">
     <legend class="text-sm font-medium px-1">Notify me when</legend>
     <label class="flex items-center justify-between gap-4 py-3 cursor-pointer" for="notify-completed">
      <span class="text-sm">A download completes</span>
      <input id="notify-completed" type="checkbox" name="completed" class="toggle toggle-primary toggle-sm" checked?={ s.Completed }/>
     </label>
     <label class="flex items-center justify-between gap-4 py-3 cursor-pointer" for="notify-failed">
      <span class="text-sm">A download fails</span>
      <input id="notify-failed" type="checkbox" name="failed" class="toggle toggle-primary toggle-sm" checked?={ s.Failed }/>
     </label>
    </fieldset>
    <div class="flex flex-wrap items-center gap-3">
     <button type="submit" class="btn btn-primary btn-sm">Save</button>
     <button type="submit" name="action" value="verify" class="btn btn-outline btn-sm" x-bind:disabled="!email.trim()" x-show="email.trim() && (!verified || email.trim() !== savedEmail)">Verify email</button>
    </div>
   </form>
   if s.Verified {
    <form method="post" action="/settings/test" class="border-t border-base-300 mt-5 pt-4 flex items-center justify-between gap-3">
     <input type="hidden" name="csrf" value={ csrf }/>
     <span class="text-xs text-base-content/80">Test delivery to your saved address.</span>
     <button type="submit" class="btn btn-ghost btn-sm" x-bind:disabled="email.trim() !== savedEmail">Send test</button>
    </form>
   }
  </div>
 </section>
}

templ ConfirmNotificationEmail(token string, csrf string) {
 <section class="mx-auto max-w-2xl px-4 py-12">
  <div class="card bg-base-100 border border-base-300 shadow-sm"><div class="card-body">
   <p class="text-xs font-bold tracking-widest uppercase text-primary">One last step</p>
   <h1 class="text-3xl font-bold">Confirm your email</h1>
   <p class="text-base-content/70 py-4">Confirm that this is the address you want to use for Seedrlike notifications. You must be signed in to the account that requested this link.</p>
   <form method="post" action="/settings/verify">
    <input type="hidden" name="token" value={ token }/>
    <input type="hidden" name="csrf" value={ csrf }/>
    <button type="submit" class="btn btn-primary">Verify my email</button>
    <a href="/settings" class="btn btn-ghost">Not now</a>
   </form>
  </div></div>
 </section>
}
