package components

templ TorrentUpload() {
 <section class="mt-5 min-w-0 rounded-box border border-base-300 bg-base-100 p-4 sm:p-5" aria-labelledby="torrent-upload-title" x-data="torrentUpload()">
  <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
   <h2 id="torrent-upload-title" class="font-semibold">Have a torrent file?</h2>
   <span class="text-xs text-base-content/70">.torrent · Up to 4 MB</span>
  </div>
  <form method="post" action="/downloads/torrent" enctype="multipart/form-data" hx-post="/downloads/torrent" hx-encoding="multipart/form-data" hx-target="#torrent-upload-response" hx-swap="innerHTML" x-ref="form"
   x-on:htmx:before-request.camel="start($event)" x-on:htmx:after-request.camel="finish($event)" x-on:htmx:xhr:progress="progress($event)" x-on:torrent-uploaded.window="accepted()" x-bind:aria-busy="busy">
   <div class="relative rounded-box border-2 border-dashed border-base-300 bg-base-200/40 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary motion-safe:transition-colors"
    x-bind:class="{ 'border-primary bg-primary/10': dragging }" x-on:dragover.prevent="dragging = !busy" x-on:dragleave.prevent="if (!$el.contains($event.relatedTarget)) dragging = false" x-on:drop.prevent="drop($event)">
    <input id="torrent-file" x-ref="file" type="file" name="torrent-file" accept=".torrent,application/x-bittorrent" required class="sr-only" aria-label="Choose a torrent file" aria-describedby="torrent-file-help torrent-file-error" x-bind:aria-invalid="!!error" x-bind:disabled="busy" x-on:change="choose($event.target.files)"/>
    <label for="torrent-file" class="flex min-h-36 cursor-pointer flex-col items-center justify-center gap-2 p-5 text-center" x-show="!file" x-bind:class="{ 'pointer-events-none': busy }">
     <span class="font-mono text-sm font-semibold text-primary" aria-hidden="true">[ .torrent ]</span>
     <span class="font-semibold" x-text="dragging ? 'Release to add your torrent' : 'Drop your torrent here'"></span>
     <span class="text-sm text-base-content/80">or <span class="underline underline-offset-4">browse files</span></span>
    </label>
    <div class="flex min-w-0 items-center gap-3 p-4 sm:p-5" x-show="file" x-cloak>
     <span class="shrink-0 rounded-lg border border-base-300 bg-base-100 px-2 py-3 font-mono text-xs font-semibold text-primary" aria-hidden="true">TOR</span>
     <div class="min-w-0 flex-1" aria-live="polite">
      <p class="break-all text-sm font-semibold" x-text="file?.name"></p>
      <p class="mt-1 text-xs text-base-content/80" x-text="file ? size(file.size) + ' · Ready to queue' : ''" x-show="!busy"></p>
      <p class="mt-1 text-xs text-base-content/80" x-show="busy" x-text="percent < 100 ? 'Uploading… ' + percent + '%' : (previewing ? 'Reading file list…' : 'Adding to queue…')"></p>
     </div>
     <button type="button" class="btn btn-ghost btn-sm shrink-0" x-on:click="remove()" x-bind:disabled="busy" aria-label="Remove selected torrent">Remove</button>
    </div>
   </div>
   <p id="torrent-file-error" class="mt-2 text-sm text-error" role="alert" x-show="error" x-text="error" x-cloak></p>
   <div x-show="busy" x-cloak class="mt-3" role="status" aria-live="polite">
    <progress class="progress progress-primary w-full" max="100" x-bind:value="percent" aria-label="Torrent file upload progress"></progress>
    <p class="mt-1 text-xs text-base-content/80" x-text="percent < 100 ? 'Uploading torrent file, not torrent contents.' : (previewing ? 'Reading files from your torrent.' : 'Checking metadata and adding your download.')"></p>
   </div>
   <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <div>
     <label class="flex cursor-pointer items-center gap-2 text-sm"><input type="checkbox" name="is-zipped" checked class="checkbox checkbox-primary checkbox-sm" x-bind:disabled="busy"/>Bundle as ZIP</label>
     <p id="torrent-file-help" class="mt-1 text-xs text-base-content/80">Download everything, or choose individual files.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
     <button type="button" class="btn btn-ghost btn-sm" x-show="file" x-cloak x-on:click="$refs.file.click()" x-bind:disabled="busy">Replace</button>
     <button type="button" hx-include="closest form" hx-vals='{"action":"preview"}' class="btn btn-outline btn-sm whitespace-nowrap" hx-post="/downloads/torrent" hx-encoding="multipart/form-data" hx-target="#file-picker-content" x-bind:disabled="!file || busy">Choose files</button>
     <button class="btn btn-primary btn-sm whitespace-nowrap" type="submit" x-bind:disabled="!file || busy" x-text="busy ? (percent < 100 ? 'Uploading…' : 'Queueing…') : 'Add to queue'">Add to queue</button>
    </div>
   </div>
  </form>
  <div id="torrent-upload-response" class="mt-3" aria-live="polite"></div>
 </section>
}
